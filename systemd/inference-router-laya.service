[Unit]
Description=Inference Router - Laya personal-data classifier (laya-serve)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inference-router
Group=inference-router
EnvironmentFile=/etc/inference-router/secrets.env
Environment=LAYA_HOST=127.0.0.1
Environment=LAYA_PORT=4101
Environment=LAYA_MODELS=english
Environment=LAYA_DEVICE=cpu
Environment=LAYA_PRELOAD=1
Environment=HF_HOME=/var/lib/inference-router/hf
ExecStart=/opt/inference-router/venv/bin/laya-serve
Restart=always
RestartSec=5
MemoryMax=3G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/inference-router
PrivateTmp=true

[Install]
WantedBy=multi-user.target
